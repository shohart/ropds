[server]
host = "0.0.0.0"
port = 8081
log_level = "info"
session_secret = "change-me-to-a-random-string"
session_ttl_hours = 24
base_url = "https://mybooks.example.com"

[library]
root_path = "/path/to/books"
book_extensions = ["fb2", "epub", "mobi", "pdf", "djvu", "zip"]
scan_zip = true
zip_codepage = "cp866"
inpx_enable = true
inpx_enrich = true             # false = fast metadata-only import for huge libraries
inpx_additional_zip_pattern = "" # e.g. "^f\\.fb2\\." for daily archives beside INPX

[covers]
covers_path = "/path/to/books/covers"
cover_max_dimension_px = 600  # Largest cover side in pixels; smaller images are kept unchanged
cover_jpeg_quality = 85       # JPEG quality for resized covers (1-100)
show_covers = true

[database]
url = "sqlite://ropds.db?mode=rwc"
max_connections = 5

[opds]
title = "Rust OPDS Server"
subtitle = "Personal Library"
max_items = 30
split_items = 300
auth_required = true
alphabet_menu = true
hide_doubles = true
# Restrict alphabet drill-down (Books / Authors / Series) to match only the
# FIRST word of each name. Default `false` keeps the legacy word-boundary
# behaviour: the prefix matches at any word boundary, so "Hakim Abdul Efendi"
# would appear under the "AB" group via the inner word "Abdul". Set to `true`
# to surface only names that themselves begin with the typed letters.
alphabet_first_word_only = false

[scanner]
schedule_minutes = [0]
schedule_hours = [0, 12]
schedule_day_of_week = []
delete_logical = false
skip_unchanged = true       # Compare mtime+size to skip unchanged archives
test_zip = false            # Validate ZIP CRC integrity before processing
test_files = false          # Verify each file extracts cleanly from archives
workers_num = 1             # Parallel scan threads (1 = sequential, for SQLite recommended range is 2..4)

[web]
language = "en"
theme = "light"

[upload]
allow_upload = false
upload_path = "uploads"
max_upload_size_mb = 100

[reader]
enable = true                  # Enable embedded book reader
read_history_max = 100         # Max reading positions stored per user

[reader.offline]
cached_books_max = 5            # Books cached in the browser for offline reading (0 disables)

[oauth]
google_client_id          = ""
google_client_secret      = ""
yandex_client_id          = ""
yandex_client_secret      = ""
keycloak_url              = ""   # e.g. https://auth.company.com
keycloak_realm            = ""   # e.g. ropds
keycloak_client_id        = ""
keycloak_client_secret    = ""
keycloak_auto_approve     = false
keycloak_role_upload      = "ropds_can_upload"
keycloak_role_admin       = "ropds_admin"
keycloak_button_label     = "Company SSO"
rejection_cooldown_hours  = 24
notify_admin_email        = false

[smtp]
host     = ""
port     = 587
username = ""
password = ""
from     = ""
send_to  = ["admin@example.com"]
starttls = true

[flibusta]
enabled = false
source_url = "http://flibusta.is/daily/"
destination = ""               # empty = library.root_path
file_pattern = "^f\\.fb2\\.[A-Za-z0-9._-]+\\.zip$"
proxy_url = ""                 # http(s)://, socks5://, socks5h://; empty = direct
timeout_secs = 120
retries = 3
validate_zip = true
scan_after_update = true
schedule_minutes = [0]
schedule_hours = [2]
schedule_day_of_week = []
max_file_size_mb = 2048
max_total_size_mb = 10240
min_free_space_mb = 2048

[telegram]
enabled = false
token = ""
proxy_url = ""                 # http(s)://, socks5://, socks5h://; empty = direct
allowed_usernames = []
max_results = 10

[convert]
enabled = false                 # Enable on-the-fly FB2 → <formats> conversion
temp_dir = "/tmp/ropds-convert" # Temp directory for converter input/output files
timeout_secs = 300              # Max seconds per conversion

# Fallback converter (Calibre ebook-convert) for formats without a specific
# entry in [convert.commands] (e.g. MOBI, which fb2cng does not produce).
default_command = "ebook-convert \"{input}\" \"{output}\""

# Target formats offered for FB2 books.
formats = ["epub", "mobi", "azw3", "pdf", "txt"]

# Per-format converter commands. fb2cng (fbc) is the default engine — clean,
# epubcheck-compliant output. {input}/{output} are shell-quoted; {output}
# already carries the target extension.
[convert.commands]
epub = "fbc convert --to epub3 --output-file \"{output}\" \"{input}\""
azw3 = "fbc convert --to azw8 --output-file \"{output}\" \"{input}\""
pdf  = "fbc convert --to pdf --output-file \"{output}\" \"{input}\""
txt  = "fbc convert --to txt --output-file \"{output}\" \"{input}\""
