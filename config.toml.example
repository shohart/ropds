[server]
host = "0.0.0.0"
port = 8081
log_level = "info"
session_secret = "change-me-to-a-random-string"
session_ttl_hours = 24
base_url = "https://mybooks.example.com"

[library]
root_path = "/path/to/books"
book_extensions = ["fb2", "epub", "mobi", "pdf", "djvu", "zip"]
scan_zip = true
zip_codepage = "cp866"
inpx_enable = false

[covers]
covers_path = "/path/to/books/covers"
cover_max_dimension_px = 600  # Largest cover side in pixels; smaller images are kept unchanged
cover_jpeg_quality = 85       # JPEG quality for resized covers (1-100)
show_covers = true

[database]
url = "sqlite://ropds.db?mode=rwc"
max_connections = 5

[opds]
title = "Rust OPDS Server"
subtitle = "Personal Library"
max_items = 30
split_items = 300
auth_required = true
alphabet_menu = true
hide_doubles = true
# Restrict alphabet drill-down (Books / Authors / Series) to match only the
# FIRST word of each name. Default `false` keeps the legacy word-boundary
# behaviour: the prefix matches at any word boundary, so "Hakim Abdul Efendi"
# would appear under the "AB" group via the inner word "Abdul". Set to `true`
# to surface only names that themselves begin with the typed letters.
alphabet_first_word_only = false

[scanner]
schedule_minutes = [0]
schedule_hours = [0, 12]
schedule_day_of_week = []
delete_logical = false
skip_unchanged = true       # Compare mtime+size to skip unchanged archives
test_zip = false            # Validate ZIP CRC integrity before processing
test_files = false          # Verify each file extracts cleanly from archives
workers_num = 1             # Parallel scan threads (1 = sequential, for SQLite recommended range is 2..4)

[web]
language = "en"
theme = "light"

[upload]
allow_upload = false
upload_path = "uploads"
max_upload_size_mb = 100

[reader]
enable = true                  # Enable embedded book reader
read_history_max = 100         # Max reading positions stored per user

[reader.offline]
cached_books_max = 5            # Books cached in the browser for offline reading (0 disables)

[oauth]
google_client_id          = ""
google_client_secret      = ""
yandex_client_id          = ""
yandex_client_secret      = ""
keycloak_url              = ""   # e.g. https://auth.company.com
keycloak_realm            = ""   # e.g. ropds
keycloak_client_id        = ""
keycloak_client_secret    = ""
keycloak_auto_approve     = false
keycloak_role_upload      = "ropds_can_upload"
keycloak_role_admin       = "ropds_admin"
keycloak_button_label     = "Company SSO"
rejection_cooldown_hours  = 24
notify_admin_email        = false

[smtp]
host     = ""
port     = 587
username = ""
password = ""
from     = ""
send_to  = ["admin@example.com"]
starttls = true

[convert]
enabled = false                # Enable on-the-fly FB2 → EPUB/MOBI conversion
temp_dir = "/tmp/ropds-convert"  # Temp directory for converter input/output files
timeout_secs = 300             # Max seconds per conversion
# Shell command templates. {input} and {output} are replaced with
# shell-quoted absolute paths. Default: Calibre's ebook-convert (FB2-aware).
# To reuse SOPDS-style converters, point these at your own scripts, e.g.:
#   fb2_to_epub = "/opt/sopds/convert/fb2conv/fb2epub {input} {output}"
fb2_to_epub = "ebook-convert \"{input}\" \"{output}\""
fb2_to_mobi = "ebook-convert \"{input}\" \"{output}\""
